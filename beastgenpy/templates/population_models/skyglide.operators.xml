%for name, info in config["sequence_info"].items():
        <hamiltonianMonteCarloOperator weight="5" nSteps="50" stepSize="1E-4"
						mode="vanilla" autoOptimize="true"
			gradientCheckCount="0"
			gradientCheckTolerance="1E-1"
			preconditioning="none"
			preconditioningUpdateFrequency="100"
			>
	 		<compoundGradient idref="${name}.full.skygrid.gradient"/>
			<compoundParameter idref="${name}.skygrid.parameters"/>
			<signTransform start="1" end="1">
				<compoundParameter idref="${name}.skygrid.parameters"/>
			</signTransform>
 		</hamiltonianMonteCarloOperator>
%endfor