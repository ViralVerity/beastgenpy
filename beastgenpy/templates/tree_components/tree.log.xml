%for name in config["sequence_info"].keys():
            <parameter idref="${name}.treeModel.rootHeight"/>
			<tmrcaStatistic idref="${name}.age(root)"/>
			<treeLengthStatistic idref="${name}.treeLength"/>
%if config["phylogeography"] == "continuous":
			<trait name="geog_rate" tag="rate">
                <discretizedBranchRates idref="${name}.coordinates.diffusionRates"/>
			</trait>
%endfor