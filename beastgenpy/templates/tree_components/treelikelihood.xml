%for name in config["sequence_info"].keys():
	<treeDataLikelihood id="${name}.treeLikelihood" useAmbiguities="false" usePreOrder="true">
		<partition>
			<patterns idref="${name}.patterns"/>
			<siteModel idref="siteModel"/>
		</partition>
		<treeModel idref="${name}.treeModel"/>
%if config["clock_model"] == "relaxed":
		<discretizedBranchRates idref="${name}.branchRates"/>
%elif config["clock_model"] == "hmc_relaxed":
		<branchRates idref="${name}.branchRates"/>
%else:
		<strictClockBranchRates idref="${name}.branchRates"/>
%endif
	</treeDataLikelihood>
%endfor
